-- 1. AUTO COOK SYSTEM
---------------------------------------------------------

local recipeMap = {
    ["Puding Waktu"] = "puding_waktu",
    ["Selai Kristal"] = "selai_kristal",
    ["Es Durian"] = "es_durian",
    ["Minyak Sawit"] = "minyak_sawit",
    ["Es Semangka"] = "es_semangka"
}

local autoCook = false
local selectedRecipeName = "Puding Waktu"

local function startAutoCook()
    task.spawn(function()
        while autoCook do
            local recipeId = recipeMap[selectedRecipeName] or selectedRecipeName
            local args = {
                "cook",
                recipeId
            }
            
            pcall(function()
                return RequestRemote:InvokeServer(unpack(args))
            end)

            task.wait(5) -- Jeda 5 detik per siklus
        end
    end)
end

