-- 2. MULTI AUTO BUY SEED SYSTEM
---------------------------------------------------------

local seedMap = {
    ["Timun"] = "timun",
    ["Padi"] = "padi",
    ["Jagung"] = "jagung",
    ["Bawang Merah"] = "bawang_merah",
    ["Bawang Putih"] = "bawang_putih",
    ["Cabe"] = "cabe",
    ["Terong"] = "terong",
    ["Semangka"] = "semangka",
    ["Ubi Ungu"] = "ubi_ungu",
    ["Pisang"] = "pisang",
    ["Lidah Buaya"] = "lidah_buaya",
    ["Durian"] = "durian",
    ["Jamur Raksasa"] = "jamur_raksasa",
    ["Pohon Buah Kristal"] = "pohon_buah_kristal"
}

local autoBuy = false
local selectedSeeds = {"Timun"}
local buyAmount = 1
local isMaxAmount = false

-- Pengecekan Ketersediaan Stok
local function checkSeedAvailable(seedId)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local shopGui = playerGui:FindFirstChild("Shop") or playerGui:FindFirstChild("Toko") or playerGui:FindFirstChild("MainGui")
        if shopGui then
            local seedFrame = shopGui:FindFirstChild(seedId, true)
            if seedFrame then
                local stockLabel = seedFrame:FindFirstChild("Stock") or seedFrame:FindFirstChild("Stok") or seedFrame:FindFirstChild("Amount")
                if stockLabel and (stockLabel:IsA("TextLabel") or stockLabel:IsA("TextBox")) then
                    local stockNum = tonumber(string.match(stockLabel.Text, "%d+"))
                    if stockNum and stockNum <= 0 then
                        return false
                    end
                end
            end
        end
    end
    return true
end

-- Function Multi Auto Buy Loop
local function startAutoBuy()
    task.spawn(function()
        while autoBuy do
            if #selectedSeeds > 0 then
                for _, seedName in ipairs(selectedSeeds) do
                    if not autoBuy then break end
                    
                    local seedId = seedMap[seedName] or seedName
                    local isAvailable = checkSeedAvailable(seedId)

                    if isAvailable then
                        local amountToBuy = isMaxAmount and 9999 or buyAmount
                        local args = {
                            "buySeed",
                            seedId,
                            amountToBuy
                        }

                        pcall(function()
                            return RequestRemote:InvokeServer(unpack(args))
                        end)

                        task.wait(0.5) -- Jeda antar pembelian benih berbeda
                    end
                end
            end
            task.wait(1.5) -- Jeda antar siklus pengecekan ulang
        end
    end)
end

